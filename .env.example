# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Supabase dashboard: Project settings -> API

# Safe to expose. Used by the browser client to resolve the session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses row-level security entirely, so it must never be
# prefixed NEXT_PUBLIC_ and never imported into a client component. RLS is
# enabled with no policies, meaning this key is the only thing that can read
# the tables - leaking it exposes every family's data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gates the in-app demo reset route so a retake never needs a terminal.
# Leave false anywhere real data could exist; it wipes and re-seeds.
ENABLE_DEMO_RESET=true
