# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Supabase dashboard: Project settings -> API Keys
#
# Supabase now issues sb_publishable_... and sb_secret_... keys, replacing the
# old eyJ... JWTs. The dashboard shows both under separate tabs. Legacy JWTs
# still work but are deprecated end of 2026, so use the new format. The
# variable names below keep the old anon/service_role wording only because
# renaming them would churn every call site for no behavioural gain.

# Publishable key - sb_publishable_... (replaces the old anon JWT).
# Safe to expose to the browser. Used to resolve the session.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Secret key - sb_secret_... (replaces the old service_role JWT). SERVER ONLY.
# Bypasses row-level security entirely, so it must never be prefixed
# NEXT_PUBLIC_ and never imported into a client component. RLS is enabled with
# no policies, meaning this key is the only thing that can read the tables -
# leaking it exposes every family's data.
#
# Unlike the old JWT, a leaked secret key is individually revocable: issue a
# replacement, swap it everywhere, then delete the compromised one. Deletion is
# permanent. The old service_role JWT could only be fixed by rotating the
# project's entire JWT secret, which invalidated every key at once.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# Gates the in-app demo reset route so a retake never needs a terminal.
# Leave false anywhere real data could exist; it wipes and re-seeds.
ENABLE_DEMO_RESET=true
